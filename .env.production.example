# Copy this file to the server-only .env, replace every REPLACE_* value, then run
# ./scripts/preflight-production.sh .env. Never commit the resulting .env file.

# Copy the matching SHA tag and digest pair from the successful "Publish production images" workflow summary.
IMAGE_TAG=REPLACE_WITH_40_CHARACTER_GIT_SHA
RUNTIME_IMAGE=ghcr.io/jueyunai/ivybm-runtime
RUNTIME_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_RUNTIME_DIGEST
WORKER_IMAGE=ghcr.io/jueyunai/ivybm-worker
WORKER_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_WORKER_DIGEST
APP_VERSION=REPLACE_WITH_40_CHARACTER_GIT_SHA

POSTGRES_DB=ivybm
POSTGRES_USER=ivybm
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql://ivybm:REPLACE_WITH_URL_ENCODED_POSTGRES_PASSWORD@db:5432/ivybm
PAYLOAD_SECRET=REPLACE_WITH_A_RANDOM_32_CHARACTER_MINIMUM_SECRET

NEXT_PUBLIC_SERVER_URL=https://ivybm.com
APP_PORT=3000
TRUST_PROXY_HEADERS=true

# Portal uses the same Next.js + Payload runtime as the website and /admin.
# The total switch and every module switch are explicit and fail closed when
# missing. External publishing remains disabled until a separate controlled-
# platform release is approved.
ADMIN_PORTAL_ENABLED=true
ADMIN_PORTAL_SETTINGS_ENABLED=true
ADMIN_PORTAL_OVERVIEW_ENABLED=true
ADMIN_PORTAL_WEBSITE_CONTENT_ENABLED=true
ADMIN_PORTAL_MEDIA_ENABLED=true
ADMIN_PORTAL_KNOWLEDGE_ENABLED=true
ADMIN_PORTAL_CONVERSATIONS_ENABLED=true
ADMIN_PORTAL_LEADS_ENABLED=true
ADMIN_PORTAL_CONTENT_STUDIO_ENABLED=true
ADMIN_PORTAL_PLATFORMS_ENABLED=true
ADMIN_PORTAL_OPERATIONS_ENABLED=true
ADMIN_PORTAL_PUBLISHING_ENABLED=false

# Set only after the Meta App, Business Login configuration and production HTTPS callbacks are ready.
# Do not print these values. The App Secret is shared by OAuth and Webhook signature verification.
# IDs are comma-separated Meta Page / Instagram Professional Account IDs.
META_APP_ID=REPLACE_WITH_META_APP_ID
META_WEBHOOK_APP_SECRET=REPLACE_WITH_META_APP_SECRET
META_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_RANDOM_META_WEBHOOK_VERIFY_TOKEN
META_WEBHOOK_ALLOWED_ACCOUNT_IDS=REPLACE_WITH_COMMA_SEPARATED_META_ACCOUNT_IDS
META_LOGIN_CONFIG_ID=REPLACE_WITH_META_BUSINESS_LOGIN_CONFIG_ID
META_OAUTH_REDIRECT_URI=https://ivybm.com/api/platforms/meta/oauth/callback

# Instagram API setup (separate from Meta/Facebook); keep this platform conditional until all
# values are configured and the exact callback is registered in the Instagram API product settings.
INSTAGRAM_APP_ID=REPLACE_WITH_INSTAGRAM_APP_ID
INSTAGRAM_APP_SECRET=REPLACE_WITH_INSTAGRAM_APP_SECRET
INSTAGRAM_OAUTH_REDIRECT_URI=https://ivybm.com/api/platforms/instagram/oauth/callback

# Required for encrypted CMS-managed provider credentials. Generate once with
# `openssl rand -hex 32`; never rotate it without first re-encrypting all keys.
AI_CONFIG_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_AI_CONFIGURATION_ENCRYPTION_KEY
# Optional until a platform account access/refresh token is stored in CMS. Generate
# separately with `openssl rand -hex 32`; never rotate without re-encrypting tokens.
PLATFORM_CREDENTIAL_ENCRYPTION_KEY=
# Optional legacy bootstrap fallback. Keep endpoint and key together, then add
# the text and/or embedding model only for a CMS operation that has no route.
# AI_PROVIDER_BASE_URL=https://api.openai.com/v1
# AI_PROVIDER_API_KEY=
# AI_TEXT_MODEL=
# AI_EMBEDDING_MODEL=
# AI_EMBEDDING_DIMENSIONS=1536
AI_TEXT_TIMEOUT_MS=30000
AI_EMBEDDING_TIMEOUT_MS=15000
# Sends {"reasoning":{"effort":"..."}} only for text generation when true.
AI_REASONING_ENABLED=false
AI_REASONING_EFFORT=medium
# Required before a Feishu mapping is activated in Payload CMS.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OAUTH_REDIRECT_URI=https://www.example.com/api/integrations/feishu/callback
FEISHU_CREDENTIAL_ENCRYPTION_KEY=
FEISHU_QR_REGISTRATION_ENABLED=false
FEISHU_RELAY_INTERVAL_MS=30000
FEISHU_OAUTH_RECOVERY_INTERVAL_MS=30000
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_JOB_HEARTBEAT_INTERVAL_MS=30000
WORKER_POLL_INTERVAL_MS=1000
