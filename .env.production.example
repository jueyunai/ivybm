# Copy this file to the server-only .env, replace every REPLACE_* value, then run
# ./scripts/preflight-production.sh .env. Never commit the resulting .env file.

# Copy the matching SHA tag and digest pair from the successful "Publish production images" workflow summary.
IMAGE_TAG=REPLACE_WITH_40_CHARACTER_GIT_SHA
RUNTIME_IMAGE=ghcr.io/jueyunai/ivybm-runtime
RUNTIME_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_RUNTIME_DIGEST
WORKER_IMAGE=ghcr.io/jueyunai/ivybm-worker
WORKER_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_WORKER_DIGEST
APP_VERSION=REPLACE_WITH_40_CHARACTER_GIT_SHA

POSTGRES_DB=ivybm
POSTGRES_USER=ivybm
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql://ivybm:REPLACE_WITH_URL_ENCODED_POSTGRES_PASSWORD@db:5432/ivybm
PAYLOAD_SECRET=REPLACE_WITH_A_RANDOM_32_CHARACTER_MINIMUM_SECRET

NEXT_PUBLIC_SERVER_URL=https://ivybm.com
APP_PORT=3000
TRUST_PROXY_HEADERS=true

# Set only after Meta App Review and the production HTTPS callback are ready. Do not print these values.
META_WEBHOOK_APP_SECRET=REPLACE_WITH_META_APP_SECRET
META_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_RANDOM_META_WEBHOOK_VERIFY_TOKEN

# Required for encrypted CMS-managed provider credentials. Generate once with
# `openssl rand -hex 32`; never rotate it without first re-encrypting all keys.
AI_CONFIG_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_AI_CONFIGURATION_ENCRYPTION_KEY
# Optional legacy bootstrap fallback. Keep endpoint and key together, then add
# the text and/or embedding model only for a CMS operation that has no route.
# AI_PROVIDER_BASE_URL=https://api.openai.com/v1
# AI_PROVIDER_API_KEY=
# AI_TEXT_MODEL=
# AI_EMBEDDING_MODEL=
# AI_EMBEDDING_DIMENSIONS=1536
AI_TEXT_TIMEOUT_MS=30000
AI_EMBEDDING_TIMEOUT_MS=15000
# Sends {"reasoning":{"effort":"..."}} only for text generation when true.
AI_REASONING_ENABLED=false
AI_REASONING_EFFORT=medium
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_JOB_HEARTBEAT_INTERVAL_MS=30000
WORKER_POLL_INTERVAL_MS=1000
