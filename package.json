{
  "name": "ivybm",
  "version": "1.0.0",
  "description": "IVYBM building materials export AI lead generation system",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "ai:eval:coverage": "node scripts/ai-eval/coverage-report.mjs",
    "ai:eval:csv": "node scripts/ai-eval/export-csv.mjs",
    "ai:eval:validate": "node scripts/ai-eval/validate.mjs",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "db:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "db:migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "db:migrate:down": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:down",
    "db:migrate:fresh": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:fresh",
    "db:migrate:refresh": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:refresh",
    "db:migrate:reset": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:reset",
    "db:migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "db:reset:test": "cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=test DISABLE_PAYLOAD_HMR=true tsx scripts/db/reset-test.ts",
    "db:seed": "cross-env NODE_OPTIONS=--no-deprecation DISABLE_PAYLOAD_HMR=true tsx src/seed/index.ts",
    "db:test:persistence": "bash scripts/db/verify-compose-persistence.sh",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "e2e:server": "node scripts/e2e/start-standalone-server.mjs",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:unit",
    "test:contract": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.contract.config.mts",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:integration": "cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=test vitest run --config ./vitest.integration.config.mts",
    "test:operations": "vitest run --config ./vitest.operations.config.mts",
    "test:unit": "node scripts/ai-eval/validate.mjs && cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts tests/unit",
    "typecheck": "tsc --noEmit",
    "worker": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=256\" DISABLE_PAYLOAD_HMR=true tsx src/worker.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tabler/icons-react": "^3.45.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.2.6",
    "payload": "3.86.0",
    "pdfjs-dist": "6.2.108",
    "qrcode.react": "^4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "28.0.0",
    "postcss": "^8.5.25",
    "prettier": "^3.4.2",
    "sass": "1.77.4",
    "tailwindcss": "^4.3.3",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "10.15.1"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
