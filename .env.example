POSTGRES_DB=ivybm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ivybm
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
# Production must use the final absolute public HTTPS origin for canonical, hreflang, sitemap and robots URLs.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
APP_VERSION=dev
# Portal modules are opt-in. Keep production fail-closed and enable only the
# reviewed modules in the environment that serves the Portal.
ADMIN_PORTAL_ENABLED=false
ADMIN_PORTAL_SETTINGS_ENABLED=false
ADMIN_PORTAL_TEAM_MANAGEMENT_ENABLED=false
ADMIN_PORTAL_OVERVIEW_ENABLED=false
ADMIN_PORTAL_WEBSITE_CONTENT_ENABLED=false
ADMIN_PORTAL_MEDIA_ENABLED=false
ADMIN_PORTAL_KNOWLEDGE_ENABLED=false
ADMIN_PORTAL_CONVERSATIONS_ENABLED=false
ADMIN_PORTAL_LEADS_ENABLED=false
ADMIN_PORTAL_CONTENT_STUDIO_ENABLED=false
# Keep real provider dispatch disabled until the platform adapter, credentials,
# readiness checks, compensation and an approved controlled test are in place.
ADMIN_PORTAL_PUBLISHING_ENABLED=false
ADMIN_PORTAL_PLATFORMS_ENABLED=false
ADMIN_PORTAL_OPERATIONS_ENABLED=false
# Production has its own server-only template: .env.production.example.
# Required when using CMS-managed AI providers. Generate 32 random bytes and store
# their 64-character hexadecimal form only in the server-side environment file.
AI_CONFIG_ENCRYPTION_KEY=
# Optional until a platform account token is saved in the CMS. Generate a separate
# 64-character hexadecimal key; app and worker receive it, migrate does not.
PLATFORM_CREDENTIAL_ENCRYPTION_KEY=
# Optional OpenAI-compatible bootstrap fallback. A CMS route takes precedence;
# leave all four values blank when every active AI route is configured in CMS.
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_TEXT_MODEL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=
AI_TEXT_TIMEOUT_MS=30000
AI_EMBEDDING_TIMEOUT_MS=15000
# OpenAI Responses-compatible reasoning is disabled by default so providers that do not
# implement the field receive the same request shape. When enabled, effort defaults to medium.
AI_REASONING_ENABLED=false
AI_REASONING_EFFORT=medium
# Optional until a Feishu mapping is activated in the CMS. Keep the app secret in
# server-side environment configuration only; never store it in the mapping record.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/feishu/callback
FEISHU_CREDENTIAL_ENCRYPTION_KEY=
FEISHU_QR_REGISTRATION_ENABLED=false
FEISHU_RELAY_INTERVAL_MS=30000
FEISHU_OAUTH_RECOVERY_INTERVAL_MS=30000
# Worker process liveness heartbeat and per-job lease heartbeat are separate clocks.
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_JOB_HEARTBEAT_INTERVAL_MS=30000
WORKER_POLL_INTERVAL_MS=1000
# E2E uses an in-process harness. The production worker always refuses _test / _ci databases;
# an isolated real-worker test must use a separate test-only entrypoint with fake transports.
# Set true only when OpenResty is the sole app ingress, strips client-supplied IP headers,
# and writes the actual address. Otherwise all anonymous chat traffic shares a safe limiter bucket.
TRUST_PROXY_HEADERS=false
# Optional until a Meta App and callback URL are configured. Never put actual values in Git.
# The App Secret is shared by server-side Facebook OAuth and Webhook signature verification.
# Configure the webhook settings together; POST fails closed with 503 until the approved
# Facebook Page / Instagram Professional Account IDs are listed. Instagram uses its own
# separate OAuth configuration below.
META_APP_ID=
META_WEBHOOK_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_ALLOWED_ACCOUNT_IDS=
META_LOGIN_CONFIG_ID=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/platforms/meta/oauth/callback
# Optional until LinkedIn OAuth is configured. Keep the client secret server-side only.
LINKEDIN_APP_ID=
LINKEDIN_APP_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=http://localhost:3000/api/platforms/linkedin/oauth/callback
LINKEDIN_API_VERSION=
LINKEDIN_UPLOAD_ALLOWED_ORIGINS=
LINKEDIN_UPLOAD_TICKET_KEY=
# Required before Instagram OAuth can be enabled; keep the platform conditional until the
# Instagram API setup and exact callback URL are registered. Never put actual values in Git.
# The secret is used only for server-side OAuth.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:3000/api/platforms/instagram/oauth/callback
# Optional local-only directory for customer media previews. It must be an absolute path outside
# this repository. Never set it in production; production media is uploaded through Payload CMS.
LOCAL_CUSTOMER_MEDIA_DIR=
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=replace-with-local-demo-password
# Local-only, explicit opt-in. Creates clearly labelled synthetic knowledge and an Active chat prompt.
SEED_KNOWLEDGE_DEMO=false
